-keep class com.example.cloble.data.local.db.CloBleDatabase { *; }
-keep class com.example.cloble.data.local.db.CloBleDatabase_Impl { *; }
-keep class * extends androidx.room.RoomDatabase { *; }
-keep class com.example.cloble.data.local.dao.** { *; }
-keep class com.example.cloble.data.local.entity.** { *; }
-keep class com.example.cloble.data.local.converter.** { *; }
-keep class com.example.cloble.data.local.session.** { *; }
-keep class com.example.cloble.domain.model.** { *; }
-keep class com.example.cloble.service.CloBleFirebaseMessagingService { *; }

-keep class org.osmdroid.** { *; }
-dontwarn org.osmdroid.**
-dontwarn okio.**
-dontwarn org.codehaus.mojo.animal_sniffer.**

-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int d(...);
    public static int i(...);
}
